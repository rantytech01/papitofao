# Public — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — NEVER prefix with NEXT_PUBLIC_, never import from client components
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used to build absolute URLs for sitemap.xml / Open Graph tags
NEXT_PUBLIC_SITE_URL=https://newtonpapito.co.ke
